# ─────────────────────────────────────────────────────────────
# H4H Insurance: environment variables
# Copy to .env.local (your computer) or .env (server) and fill in.
# NEVER commit real values. Git ignores .env* files except this one.
# ─────────────────────────────────────────────────────────────

# Google service account: reads/writes the H4H_Form spreadsheet
# (quote, contact, careers, appointment forms + Agents/AgentLeads tabs)
NEXT_PUBLIC_GOOGLE_CLIENT_EMAIL=
# Keep the quotes and the \n pieces exactly as Google provides them
NEXT_PUBLIC_GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Gmail account that sends website emails
# (use a Google "App Password", not the account's login password)
EMAIL_USER=
EMAIL_PASS=

# Meta Pixel / Conversions API: not active yet, leave commented
# META_PIXEL_ID=
# META_CAPI_TOKEN=
# META_TEST_EVENT_CODE=
# META_VERIFY_TOKEN=

# Optional: agent pages
# NEXT_PUBLIC_SITE_URL=https://h4hinsurance.com
# H4H_SPREADSHEET_ID=
# AGENT_LEADS_CC=justme@aol.com